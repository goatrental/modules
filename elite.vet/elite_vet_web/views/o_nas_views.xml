<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_about_form" model="ir.ui.view">
        <field name="name">elite.vet.about.form</field>
        <field name="model">elite.vet.about</field>
        <field name="arch" type="xml">
            <form string="O nás">
                <sheet>
                    <div class="alert alert-info" role="status">
                        Tenhle formulář je celá stránka <b>/o-nas</b>, odshora dolů přesně
                        tak, jak ji uvidí návštěvník: štítek, nadpis, text, obrázek a video.
                    </div>
                    <field name="image" widget="image" class="oe_avatar"
                           options="{'size': [280, 200]}"/>
                    <div class="oe_title">
                        <label for="badge" string="Štítek nad nadpisem"/>
                        <h3><field name="badge" placeholder="O KLINICE"/></h3>
                        <label for="name" string="Nadpis"/>
                        <h1><field name="name" placeholder="O nás"/></h1>
                    </div>
                    <group>
                        <group string="Obrázek">
                            <field name="image_alt" placeholder="Ordinace Elite Vet"
                                   invisible="not image"/>
                            <div colspan="2" class="text-muted" invisible="image">
                                Fotku nahraješ kliknutím na rámeček vpravo nahoře.
                                Bez ní se na stránce nic nevykreslí.
                            </div>
                        </group>
                        <group string="Video z YouTube">
                            <field name="video_url"
                                   placeholder="https://www.youtube.com/watch?v=…"/>
                            <field name="video_id" readonly="1" invisible="not video_id"/>
                            <div colspan="2" class="text-muted">
                                Zkopíruj adresu přímo z YouTube — funguje <b>youtu.be/…</b>,
                                <b>youtube.com/watch?v=…</b> i odkaz na Shorts. Přehrávač se
                                poskládá sám a vloží se v režimu bez cookies, takže nesbírá
                                návštěvníkovi data, dokud video nespustí. Prázdné pole
                                znamená, že tam video nebude.
                            </div>
                        </group>
                    </group>
                    <group string="Text pod nadpisem">
                        <field name="body" nolabel="1" colspan="2"
                               placeholder="Odstavce, které se ukážou pod nadpisem."/>
                        <div colspan="2" class="text-muted">
                            Text jde přeložit: přepni jazyk vpravo nahoře a přepiš ho.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stranka je jeden zaznam, proto nabidka vede na serverovou akci, ktera ho
         najde a otevre. Obycejna akce by otevrela seznam o jednom radku. -->
    <record id="action_about" model="ir.actions.server">
        <field name="name">O nás</field>
        <field name="model_id" ref="model_elite_vet_about"/>
        <field name="state">code</field>
        <field name="code">action = model.otevrit()</field>
    </record>

    <menuitem id="menu_o_nas_root" name="O nás" sequence="54"
              groups="elite_vet_calendar.group_calendar_manager"/>
    <menuitem id="menu_o_nas_obsah" name="Text a video" parent="menu_o_nas_root"
              action="action_about" sequence="10"/>

</odoo>
